---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllBlogPosts, getBlogPostBySlug, getImageUrl } from "../../lib/contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";

export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post) => ({
    params: { slug: post.fields.slug as string },
  }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug!);

if (!post) {
  return Astro.redirect("/blog", 301);
}

const title = post.fields.title as string;
const excerpt = post.fields.excerpt as string | undefined;
const publishedDate = post.fields.publishedDate as string;
const authorName = (post.fields.author as any)?.fields?.name as string | undefined;
const authorBio = (post.fields.author as any)?.fields?.bio as string | undefined;
const contentHtml = post.fields.content ? documentToHtmlString(post.fields.content as any) : "";
const imageUrl = getImageUrl(post.fields.featuredImage as any);

const [y, m, d] = publishedDate.slice(0, 10).split("-").map(Number);
const formattedDate = new Date(y, m - 1, d).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={title}
  description={excerpt}
  ogImage={imageUrl}
  articleMeta={{
    publishedTime: publishedDate,
    author: authorName,
    section: "Blog",
  }}
>
  <article>
    <!-- Hero -->
    <section class="bg-gradient-to-b from-[#e7d9cb] to-white py-14">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <nav class="mb-6">
          <a href="/blog" class="inline-flex items-center gap-1.5 text-sm text-[#3d4435] hover:underline font-medium">
            ← All Posts
          </a>
        </nav>
        <div class="flex flex-wrap items-center gap-2 text-sm text-[#2a2a2a] mb-4">
          {authorName && <span>By {authorName}</span>}
          {authorName && <span class="text-[#d4c8bc]">·</span>}
          <span>{formattedDate}</span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl mb-4 leading-tight">{title}</h1>
        {excerpt && <p class="text-lg text-[#2a2a2a] leading-relaxed">{excerpt}</p>}
      </div>
    </section>

    {imageUrl && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-6 mb-12">
        <img
          src={imageUrl}
          alt={title}
          class="w-full rounded-2xl object-cover shadow-sm"
          style="aspect-ratio: 16/9;"
          loading="eager"
        />
      </div>
    )}

    <section class="pb-16">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <div class="prose-catalina" set:html={contentHtml} />

        {(authorName || authorBio) && (
          <div class="mt-12 p-6 bg-[#f2ece4] border border-[#d4c8bc] rounded-2xl flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-[#3d4435]/20 flex items-center justify-center shrink-0">
              <span class="font-display font-bold text-[#3d4435] text-lg">
                {(authorName ?? "?").charAt(0)}
              </span>
            </div>
            <div>
              {authorName && <p class="font-semibold text-[#111111] mb-1">{authorName}</p>}
              {authorBio && <p class="text-[#2a2a2a] text-sm leading-relaxed">{authorBio}</p>}
            </div>
          </div>
        )}

        <!-- CTA -->
        <div class="mt-10 p-8 bg-gradient-to-br from-[#e7d9cb] to-[#f2ece4] border border-[#d4c8bc] rounded-2xl text-center">
          <p class="font-display text-xl text-[#111111] mb-2">Hungry for more?</p>
          <p class="text-[#2a2a2a] text-sm mb-6">Explore recipes or check out this week's meal plan.</p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href="/recipes"
              class="px-6 py-3 rounded-full bg-[#3d4435] text-white font-semibold text-sm hover:bg-[#111111] transition-colors"
            >
              Browse Recipes
            </a>
            <a
              href="/meal-plans"
              class="px-6 py-3 rounded-full border border-[#3d4435]/40 text-[#3d4435] font-semibold text-sm hover:bg-[#3d4435]/10 transition-colors"
            >
              Meal Plans
            </a>
          </div>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
