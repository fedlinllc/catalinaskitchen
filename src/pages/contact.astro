---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact"
  description="Contact form coming soon. Catalina's Kitchen — recipe questions, ingredient substitutions, and more."
  noindex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-[#111111] uppercase tracking-widest text-xs font-semibold mb-4">Coming Soon</p>
    <h1 class="font-display text-4xl mb-4">Get in Touch</h1>
    <p class="text-[#2a2a2a] max-w-md mx-auto leading-relaxed">
      A contact form is on the way. Check back soon.
    </p>
  </div>
</BaseLayout>
