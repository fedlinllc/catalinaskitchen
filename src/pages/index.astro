---
import BaseLayout from "../layouts/BaseLayout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import NewsletterSignup from "../components/NewsletterSignup";
import { getAllRecipes } from "../lib/contentful";

const recipes = await getAllRecipes();
const featuredRecipes = recipes.slice(0, 6);

const categoryTiles = [
  { id: "breakfast", label: "Breakfast",      img: "/images/screen-shot-2024-08-21-at-6.33.12-pm.png" },
  { id: "dinner",    label: "Dinner",          img: "/images/screenshot-2025-01-22-at-3.29.30-pm.png" },
  { id: "sides",     label: "Sides",           img: "/images/screen-shot-2024-07-03-at-5.52.20-pm.jpg" },
  { id: "sauces",    label: "Sauces & Salsas", img: "/images/screen-shot-2024-06-12-at-6.52.18-pm.png" },
  { id: "dessert",   label: "Dessert",         img: "/images/screen-shot-2024-02-21-at-8.20.17-am.png" },
] as const;
---

<BaseLayout
  title="Catalina's Kitchen — Flavorful, Healthy, Multicultural Cooking"
  description="Your certified guide to flavorful, bold, healthy, multiculturally inspired cooking. Free recipes, meal plans, and nutrition guidance."
>
  <!-- Newsletter Banner -->
  <div class="bg-[#A06820] text-white py-2.5 text-center text-sm font-medium tracking-widest uppercase">
    Never Miss a Recipe!&nbsp;
    <a href="#newsletter" class="underline underline-offset-2 hover:opacity-80">Subscribe →</a>
  </div>

  <!-- Hero: full-bleed category grid with overlaid tagline -->
  <section class="relative h-[82vh] min-h-[520px] overflow-hidden">

    <!-- Category image grid — fills the entire section as background -->
    <div class="absolute inset-0 grid grid-cols-5">
      {categoryTiles.map(({ id, label, img }) => (
        <a href={`/recipes?category=${id}`} class="group relative overflow-hidden">
          <img
            src={img}
            alt={label}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="eager"
          />
          <!-- Per-tile gradient + category label at the bottom -->
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 to-transparent pt-10 pb-4 px-2 text-center">
            <span class="text-white text-xs font-semibold uppercase tracking-widest drop-shadow">
              {label}
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Full overlay for text readability -->
    <div class="absolute inset-0 bg-black/45" />

    <!-- Centered tagline -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-4">
      <p class="text-white/70 uppercase tracking-widest text-xs font-semibold mb-4">
        Your Certified Guide
      </p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-white leading-tight mb-6 drop-shadow-lg">
        Flavorful, Bold,<br />
        <span class="text-[#D4A040]">Healthy</span> Cooking.
      </h1>
      <p class="text-white/80 max-w-xl mx-auto text-lg leading-relaxed mb-10 drop-shadow">
        Multiculturally inspired recipes that help you build a healthier relationship
        with food — without sacrificing flavor.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/recipes"
          class="bg-[#A06820] hover:bg-[#7A4E15] text-white font-medium px-8 py-3 rounded-xl transition-colors shadow-lg"
        >
          Browse Recipes
        </a>
        <a
          href="/meal-plans"
          class="border-2 border-white/80 text-white hover:bg-white hover:text-[#3D2B0F] font-medium px-8 py-3 rounded-xl transition-colors backdrop-blur-sm"
        >
          Meal Plans
        </a>
      </div>
    </div>

  </section>

  <!-- Nutrition Guidance Section -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <img
            src="/images/img_3081.jpg"
            alt="Healthy, colorful home-cooked food"
            class="rounded-2xl w-full object-cover aspect-[4/3] shadow-sm"
            loading="lazy"
          />
        </div>
        <div>
          <p class="text-[#A06820] uppercase tracking-widest text-xs font-semibold mb-3">
            Nutrition Guidance
          </p>
          <h2 class="font-display text-3xl md:text-4xl text-[#3D2B0F] mb-6">
            Improving your relationship with food
          </h2>
          <div class="space-y-6">
            <div>
              <h3 class="font-semibold text-[#3D2B0F] mb-2">Try something new</h3>
              <p class="text-[#5C3D1E] leading-relaxed">
                Begin exploring your relationship with food by trying any of my free recipes
                and meal plans. Healthy food should also be delicious.
              </p>
            </div>
            <div>
              <h3 class="font-semibold text-[#3D2B0F] mb-2">Specific Issues</h3>
              <p class="text-[#5C3D1E] leading-relaxed">
                If allergies, illness, or other aversions have complicated your relationship
                with food, send me a message and I can give you the best option as a
                replacement for the specific ingredient.
              </p>
            </div>
            <a
              href="/contact"
              class="inline-block bg-[#A06820] hover:bg-[#7A4E15] text-white font-medium px-6 py-3 rounded-xl transition-colors"
            >
              Get in Touch
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Recipes (Contentful-driven, only renders when populated) -->
  {featuredRecipes.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 py-16">
      <div class="flex items-center justify-between mb-8">
        <h2 class="font-display text-3xl text-[#3D2B0F]">Latest Recipes</h2>
        <a href="/recipes" class="text-sm text-[#A06820] hover:underline font-medium">View all →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredRecipes.map((recipe) => (
          <RecipeCard recipe={recipe} />
        ))}
      </div>
    </section>
  )}

  <!-- Newsletter CTA -->
  <section id="newsletter" class="bg-[#F5EDDA] border-y border-[#DDC9A0]">
    <div class="max-w-2xl mx-auto px-4 py-16 text-center">
      <p class="text-[#A06820] uppercase tracking-widest text-xs font-semibold mb-3">Stay Connected</p>
      <h2 class="font-display text-3xl text-[#3D2B0F] mb-3">Never Miss a Recipe!</h2>
      <p class="text-[#5C3D1E] mb-8">
        Get new recipes, meal plans, and cooking tips delivered to your inbox.
      </p>
      <NewsletterSignup client:load />
    </div>
  </section>
</BaseLayout>
