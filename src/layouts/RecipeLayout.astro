---
import BaseLayout from "./BaseLayout.astro";
import { getImageUrl } from "../lib/contentful";
import type { RecipeSkeleton } from "../lib/contentful";
import type { Entry } from "contentful";
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";

interface Props {
  recipe: Entry<RecipeSkeleton>;
}

const { recipe } = Astro.props;
const { title, excerpt, category, publishedDate, featuredImage, ingredients, instructions } = recipe.fields;
const authorName = (recipe.fields.author as any)?.fields?.name as string | undefined;

const imageUrl = getImageUrl(featuredImage as any);
const ingredientsHtml = ingredients ? documentToHtmlString(ingredients as any) : "";
const instructionsHtml = instructions ? documentToHtmlString(instructions as any) : "";

function nodeText(node: any): string {
  if (node.nodeType === "text") return node.value ?? "";
  return (node.content ?? []).map(nodeText).join("");
}

function schemaIngredients(doc: any): string[] {
  if (!doc?.content) return [];
  const out: string[] = [];
  for (const block of doc.content) {
    if (block.nodeType === "unordered-list" || block.nodeType === "ordered-list") {
      for (const item of block.content ?? []) {
        const t = nodeText(item).trim();
        if (t) out.push(t);
      }
    } else {
      const t = nodeText(block).trim();
      if (t) out.push(t);
    }
  }
  return out;
}

function schemaSteps(doc: any): { "@type": string; text: string }[] {
  if (!doc?.content) return [];
  return (doc.content as any[])
    .map((block) => nodeText(block).trim())
    .filter(Boolean)
    .map((text) => ({ "@type": "HowToStep", text }));
}

const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": title,
  "description": excerpt ?? "",
  "image": imageUrl ? [imageUrl] : [],
  ...(authorName ? { "author": { "@type": "Person", "name": authorName } } : {}),
  "datePublished": publishedDate,
  "recipeCategory": category,
  "recipeIngredient": schemaIngredients(ingredients),
  "recipeInstructions": schemaSteps(instructions),
};

const categoryLabels: Record<string, string> = {
  dinner: "Dinner",
  sides: "Sides",
  sauces: "Sauces & Salsas",
  breakfast: "Breakfast",
  dessert: "Dessert",
};
const categoryLabel = categoryLabels[category as string] ?? (category as string);

const [y, m, d] = (publishedDate as string).slice(0, 10).split("-").map(Number);
const formattedDate = new Date(y, m - 1, d).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={title as string}
  description={excerpt as string | undefined}
  ogImage={imageUrl}
  articleMeta={{
    publishedTime: publishedDate as string,
    author: authorName,
    section: category as string,
  }}
>
  <script slot="head-schema" type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />

  <article>
    <!-- Hero with gradient -->
    <section class="bg-gradient-to-b from-[#e7d9cb] to-white py-14">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <nav class="mb-6">
          <a href="/recipes" class="inline-flex items-center gap-1.5 text-sm text-[#3d4435] hover:underline font-medium">
            ← All Recipes
          </a>
        </nav>
        <span class="inline-block text-xs uppercase tracking-widest font-semibold text-white bg-[#3d4435] px-3 py-1 rounded-full mb-4">
          {categoryLabel}
        </span>
        <h1 class="font-display text-4xl md:text-5xl mb-4 leading-tight">{title}</h1>
        {excerpt && <p class="text-lg text-[#2a2a2a] leading-relaxed mb-5">{excerpt}</p>}
        <div class="flex flex-wrap items-center gap-2 text-sm text-[#2a2a2a]">
          {authorName && <span>By {authorName}</span>}
          {authorName && <span class="text-[#d4c8bc]">·</span>}
          <span>{formattedDate}</span>
        </div>
      </div>
    </section>

    {imageUrl && (
      <div class="max-w-4xl mx-auto px-4 sm:px-6 -mt-6 mb-12">
        <img
          src={imageUrl}
          alt={title as string}
          class="w-full rounded-2xl object-cover shadow-sm"
          style="aspect-ratio: 16/9;"
          loading="eager"
        />
      </div>
    )}

    <div class="max-w-3xl mx-auto px-4 sm:px-6 pb-16">
      <!-- Ingredients card -->
      {ingredientsHtml && (
        <section class="ingredients-card mb-10" aria-label="Ingredients">
          <h2 class="font-display text-2xl mb-5 text-[#111111]">Ingredients</h2>
          <div class="prose-catalina" set:html={ingredientsHtml} />
        </section>
      )}

      <!-- Instructions: numbered steps -->
      {instructionsHtml && (
        <section class="mb-12" aria-label="Instructions">
          <h2 class="font-display text-2xl mb-6 pb-2 border-b border-[#d4c8bc] text-[#111111]">
            Instructions
          </h2>
          <div class="prose-catalina prose-instructions" set:html={instructionsHtml} />
        </section>
      )}

      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  /* ── Ingredients card ─────────────────────────────────────── */
  .ingredients-card {
    background: #f2ece4;
    border: 1px solid #d4c8bc;
    border-radius: 1rem;
    padding: 1.5rem 2rem 1.25rem;
  }
  .ingredients-card :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ingredients-card :global(li) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(212, 200, 188, 0.5);
    color: #2a2a2a;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .ingredients-card :global(li:last-child) {
    border-bottom: none;
  }
  .ingredients-card :global(li)::before {
    content: '';
    flex-shrink: 0;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: 0.55em;
    background: #3d4435;
    border-radius: 50%;
  }

  /* ── Instruction numbered steps ───────────────────────────── */
  .prose-instructions :global(ol) {
    list-style: none;
    padding: 0;
    counter-reset: step;
  }
  .prose-instructions :global(ol > li) {
    counter-increment: step;
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    border-bottom: 1px solid #e7d9cb;
    color: #2a2a2a;
    line-height: 1.75;
  }
  .prose-instructions :global(ol > li:last-child) {
    border-bottom: none;
  }
  .prose-instructions :global(ol > li)::before {
    content: counter(step);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    background: #3d4435;
    color: white;
    font-weight: 700;
    font-size: 0.875rem;
    border-radius: 50%;
    margin-top: 0.1rem;
  }
</style>
