---
import { getImageUrl, RECIPE_CATEGORIES } from "../lib/contentful";
import type { RecipeSkeleton } from "../lib/contentful";
import type { Entry } from "contentful";

interface Props {
  recipe: Entry<RecipeSkeleton>;
}

const { recipe } = Astro.props;
const { title, slug, excerpt, category, publishedDate, featuredImage } = recipe.fields;
const imageUrl = getImageUrl(featuredImage as any);
const categoryLabel = RECIPE_CATEGORIES.find((c) => c.id === category)?.label ?? category;
---

<a
  href={`/recipes/${slug}`}
  class="group block rounded-2xl overflow-hidden bg-[#f2ece4] border border-[#d4c8bc] hover:shadow-lg transition-shadow"
>
  <div class="aspect-video overflow-hidden bg-[#e7d9cb]">
    {imageUrl ? (
      <img
        src={imageUrl}
        alt={title as string}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-[#6b6b6b]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
  </div>

  <div class="p-5">
    <span class="text-xs uppercase tracking-widest text-[#111111] font-semibold">
      {categoryLabel}
    </span>
    <h3 class="font-display text-lg mt-1 mb-2 group-hover:text-[#111111] transition-colors line-clamp-2">
      {title}
    </h3>
    {excerpt && (
      <p class="text-sm text-[#2a2a2a] line-clamp-2 leading-relaxed">{excerpt}</p>
    )}
    <p class="text-xs text-[#6b6b6b] mt-3">
      {new Date(publishedDate as string).toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "numeric",
      })}
    </p>
  </div>
</a>
